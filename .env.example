# Comma-separated X handles (without @). Start with a small explicit allowlist.
X_MONITORED_HANDLES=example_creator

# A Playwright storage-state JSON file created by scripts/save_x_login.py.
# Keep this file outside Git and treat it like a password.
X_STORAGE_STATE_PATH=~/.local/share/x-subscriber-listener/storage_state.json

# At least 300 seconds by default. Don't use aggressive polling.
POLL_INTERVAL_SECONDS=300
MAX_POSTS_PER_PROFILE=30
NAVIGATION_TIMEOUT_MS=45000

# Local runtime data. Defaults outside the repository.
X_DATA_DIR=~/.local/share/x-subscriber-listener
X_DATABASE_PATH=~/.local/share/x-subscriber-listener/posts.sqlite3
LOG_LEVEL=INFO

# Optional Telegram notifications. Leave blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional Diamond Bot forwarding is OFF by default. Enable only after reviewing
# your actual Diamond Bot endpoint schema and authentication requirements.
DIAMOND_WEBHOOK_ENABLED=false
DIAMOND_WEBHOOK_URL=
DIAMOND_WEBHOOK_TOKEN=
